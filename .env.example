# Bu dosyayı ".env" olarak kopyalayıp kendi değerlerinizi girin.
# Discord Developer Portal: https://discord.com/developers/applications

# Discord Bot Token (Developer Portal > Bot > Reset Token)
TOKEN=

# Uygulama (Client) ID'si (Developer Portal > General Information)
CLIENT_ID=

# (İsteğe bağlı) Komutları sadece bu sunucuya kaydeder.
# Boş bırakılırsa komutlar global olarak kaydedilir.
GUILD_ID=
